# Template para docker-compose.prod.yml. Não commite este arquivo preenchido.
# cp .env.prod.example .env   (na VM)  ou  .env.prod (teste local)

DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key-32chars-min
DJANGO_ALLOWED_HOSTS=www.ibsantaleopoldina.com.br,ibsantaleopoldina.com.br
CSRF_TRUSTED_ORIGINS=https://www.ibsantaleopoldina.com.br,https://ibsantaleopoldina.com.br
WAGTAILADMIN_BASE_URL=https://www.ibsantaleopoldina.com.br

POSTGRES_DB=ibconecta
POSTGRES_USER=ibconecta
POSTGRES_PASSWORD=replace-with-a-strong-db-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@ibsantaleopoldina.com.br
DJANGO_SUPERUSER_PASSWORD=replace-with-a-strong-admin-password
DJANGO_SEED_DEMO=false

SITE_ADDRESS=www.ibsantaleopoldina.com.br
ACME_EMAIL=admin@ibsantaleopoldina.com.br
# Vazio = Let's Encrypt. Para testar o compose na máquina local:
# SITE_ADDRESS=localhost
# CADDY_TLS=tls internal
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CADDY_TLS=

# Customer Secret Keys do Object Storage (S3-compatible). Opcionais:
# sem elas, mídia pública fica no volume Docker media_data.
OCI_S3_ACCESS_KEY=
OCI_S3_SECRET_KEY=
OCI_S3_BUCKET=ib-conecta-prod-storage
OCI_S3_NAMESPACE=
OCI_S3_REGION=sa-saopaulo-1
OCI_S3_ENDPOINT=
