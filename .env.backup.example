# Copie para .env.backup na VM (não commitar o arquivo preenchido).
# A EC2 usa instance profile: não coloque AWS_ACCESS_KEY_ID aqui em produção.

BACKUP_S3_BUCKET=ib-conecta-prod-backups-354354997468
BACKUP_S3_REGION=us-east-2
BACKUP_AGE_RECIPIENTS=backup/age-recipients.txt
BACKUP_COMPOSE_FILE=docker-compose.prod.yml
BACKUP_ENV_FILE=.env.prod

# Local / LocalStack (scripts\backup-local.bat preenche isto):
# BACKUP_S3_BUCKET=ib-conecta-backups
# BACKUP_COMPOSE_FILE=docker-compose.yml
# BACKUP_ENV_FILE=.env
# AWS_ENDPOINT_URL=http://localhost:4566
# AWS_ACCESS_KEY_ID=test
# AWS_SECRET_ACCESS_KEY=test
# AWS_DEFAULT_REGION=us-east-2
# BACKUP_AGE_IDENTITY=.scratch/ib-conecta-backup.age.key
