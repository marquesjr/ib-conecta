# Copie para terraform.tfvars e preencha. Não commite terraform.tfvars.

aws_profile = "default"
region      = "us-east-2"

project_name = "ib-conecta"
environment  = "prod"

# Lightsail 1 GB (ADR 0013). IDs: aws lightsail get-bundles --region us-east-2
lightsail_bundle_id    = "micro_3_0"
lightsail_blueprint_id = "ubuntu_24_04"
# availability_zone    = "us-east-2a"

# Cole a chave pública OpenSSH (uma linha)
ssh_public_key = "ssh-ed25519 AAAA... usuario@host"

# Repo cujo workflow em master assume a role de deploy (ADR 0012).
# Prefixo do claim sub (Settings → Actions → OIDC). Este repo é posterior a 15/07/2026:
# github_oidc_sub_prefix = "repo:marquesjr@2216233/ib-conecta@1314311915"

# Restrinja SSH ao seu IP — não use 0.0.0.0/0
ssh_allowed_cidrs = [
  "203.0.113.10/32",
]

# Teto do AWS Budget (alerta em 80%) e destino do alerta
budget_limit_usd   = 12
budget_alert_email = "voce@example.com"

# enable_budget = false

tags = {
  owner = "igreja-batista-santa-leopoldina"
}
