DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me-in-local-dev
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web
POSTGRES_DB=ibconecta
POSTGRES_USER=ibconecta
POSTGRES_PASSWORD=ibconecta
POSTGRES_HOST=db
POSTGRES_PORT=5432
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=admin
# Popular o ambiente local com conteúdo fictício (não usar em produção)
DJANGO_SEED_DEMO=true
# Acervo do Instagram. Exige conta Profissional (Criador ou Empresa) — conta pessoal
# não tem acesso a nenhuma API oficial. O token de longa duração NÃO fica aqui: cadastre
# com `manage.py set_instagram_token` para que a renovação programada possa reescrevê-lo.
# INSTAGRAM_ACCESS_TOKEN é lido apenas por esse comando, no primeiro cadastro.
INSTAGRAM_ACCESS_TOKEN=
# Somente para o caminho Login do Facebook (conta Empresa ligada a uma Página).
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# --- Produção (docker-compose.prod.yml) ---
# Copie também .env.prod.example. DJANGO_DEBUG deve permanecer false.
# SITE_ADDRESS=www.ibsantaleopoldina.com.br
# ACME_EMAIL=admin@ibsantaleopoldina.com.br
# CADDY_TLS=   # vazio na VM = Let's Encrypt; "tls internal" só para teste local
# CSRF_TRUSTED_ORIGINS=https://www.ibsantaleopoldina.com.br,https://ibsantaleopoldina.com.br
# WAGTAILADMIN_BASE_URL=https://www.ibsantaleopoldina.com.br
# WEB_CONCURRENCY=1
# Backup S3 local (LocalStack via scripts\deploy-local.bat, depois scripts\backup-local.bat):
# AWS_ENDPOINT_URL=http://localhost:4566
# AWS_ACCESS_KEY_ID=test
# AWS_SECRET_ACCESS_KEY=test
# AWS_DEFAULT_REGION=us-east-2
# BACKUP_S3_BUCKET=ib-conecta-backups
# BACKUP_AGE_RECIPIENTS=backup/age-recipients.txt
